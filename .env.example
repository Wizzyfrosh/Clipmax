DATABASE_URL=postgresql://USER:PASSWORD@HOST/clipmax?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/clipmax?sslmode=require
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=Clipmax <hello@your-domain.com>
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clipmax
OPENAI_API_KEY=
# Must support chat completions with JSON schema output. Choose after evaluation.
TEXT_MODEL=
# Paid processing is off until configured and explicitly enabled.
PROCESSING_ENABLED=false
# Conservative upper-bound reservation per AI job, integer micro-USD.
AI_JOB_BUDGET_MICROS=1000000
MONTHLY_AI_BUDGET_MICROS=15000000
ADMIN_EMAILS=
# Comma-separated email addresses approved for private-pilot registration.
# Empty means registration is closed. This does not grant administrator access.
PILOT_INVITE_EMAILS=
